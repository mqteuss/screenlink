{
  "name": "screenlink-web",
  "version": "1.0.5",
  "description": "Chamadas P2P, voz, chat e compartilhamento de tela no navegador e no desktop.",
  "author": "ScreenLink",
  "repository": {
    "type": "git",
    "url": "https://github.com/mqteuss/screenlink.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node scripts/smoke-signaling.mjs",
    "test:desktop-capture": "electron scripts/smoke-electron-display.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win --publish never",
    "desktop:release": "npm run desktop:dist"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "app.screenlink.desktop",
    "productName": "ScreenLink",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.mjs",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "mqteuss",
      "repo": "screenlink",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScreenLink",
      "artifactName": "ScreenLink-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ScreenLink-Portable-${arch}.${ext}"
    }
  }
}
