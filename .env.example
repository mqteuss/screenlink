# Porta local. Em hospedagem, o provedor normalmente define PORT automaticamente.
PORT=8787

# Opcional. Use a URL pública do deploy ou de um túnel HTTPS. Sem esta variável,
# convites criados em localhost usam automaticamente o IPv4 da rede local.
PUBLIC_ORIGIN=

# Origens extras autorizadas a abrir o WebSocket (separadas por vírgula).
# Útil somente quando a interface e o servidor ficam em domínios diferentes.
ALLOWED_ORIGINS=

# Proteção contra consumo de memória por criação ilimitada de salas.
MAX_ACTIVE_ROOMS=2500

# Limite defensivo de conexões WebSocket simultâneas.
MAX_CONNECTIONS=10000

# O STUN ajuda os dispositivos a descobrir um caminho P2P direto.
STUN_URLS=stun:stun.cloudflare.com:3478

# Opcional. TURN é usado somente quando a conexão P2P direta é bloqueada por NAT,
# CGNAT ou firewall. Prefira um relay geograficamente próximo dos usuários.
# É possível informar vários endereços separados por vírgula, incluindo UDP/TCP/TLS.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
